#include <behaviors/unicode.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include <zmk-unicode/keys/blocks/latin_1_supplement.h>

#define BASE 0
#define NUMBERS 1
#define SYMBOLS 2
#define NAV 3
#define MOUSE 4
#define EXTRA 5
#define SYSTEM 6

#define FINGERS_LEFT_TOP      1  2  3  4  5
#define FINGERS_RIGHT_TOP     6  7  8  9 10
#define FINGERS_LEFT_MIDDLE  13 14 15 16 17
#define FINGERS_RIGHT_MIDDLE 18 19 20 21 22
#define FINGERS_LEFT_BOTTOM  25 26 27 28 29
#define FINGERS_RIGHT_BOTTOM 30 31 32 33 34

#define THUMBS_LEFT  36 37 38
#define THUMBS_RIGHT 39 40 41

#define HAND_RIGHT_KEYS FINGERS_RIGHT_TOP FINGERS_RIGHT_MIDDLE FINGERS_RIGHT_BOTTOM THUMBS_RIGHT
#define HAND_LEFT_KEYS FINGERS_LEFT_TOP FINGERS_LEFT_MIDDLE FINGERS_LEFT_BOTTOM THUMBS_LEFT

#define BASE_TIME 150
#define REPEAT_DECAY (BASE_TIME + 150)
#define STREAK_DECAY BASE_TIME
#define INDEX_HOLDING_TIME (BASE_TIME + 30)
#define MIDDY_HOLDING_TIME (BASE_TIME + 60)
#define RINGY_HOLDING_TIME (BASE_TIME + 90)
#define PINKY_HOLDING_TIME (BASE_TIME + 120)

&uc { default-mode = <UC_MODE_LINUX>; };

&lt { quick-tap-ms = <150>; };

/ {
    behaviors {
        hrm_left_pinky: hrm_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_RIGHT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_left_ringy: hrm_left_ringy {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_RIGHT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_left_middy: hrm_left_middy {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_RIGHT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_left_index: hrm_left_index {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_RIGHT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_right_pinky: hrm_right_pinky {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_LEFT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_right_ringy: hrm_right_ringy {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_LEFT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_right_middy: hrm_right_middy {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_LEFT_KEYS>;
            hold-trigger-on-release;
        };

        hrm_right_index: hrm_right_index {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;

            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <REPEAT_DECAY>;
            require-prior-idle-ms = <STREAK_DECAY>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <HAND_LEFT_KEYS>;
            hold-trigger-on-release;
        };

        parenthesis: parenthesis {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            label = "PARENTHESIS";
        };

        brackets: brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        braces: braces {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACES";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        slashes: slashes {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            label = "SLASHES";
        };

        marks: marks {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp QUESTION>;

            label = "MARKS";
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            timeout-ms = <30>;
            bindings = <&kp ESCAPE>;
            key-positions = <20 15>;
        };

        vimfind {
            timeout-ms = <30>;
            bindings = <&kp KP_DIVIDE>;
            key-positions = <16 19>;
        };

        vimcmd {
            bindings = <&kp COLON>;
            key-positions = <3 8>;
            timeout-ms = <30>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
&none  &kp COLON                    &kp COMMA                   &kp PERIOD                      &kp P                         &kp Y           &kp F        &kp G                          &kp C                            &kp R                        &kp L                        &none
&none  &hrm_left_pinky LEFT_GUI A   &hrm_left_ringy LEFT_ALT O  &hrm_left_middy LEFT_CONTROL E  &hrm_left_index LEFT_SHIFT U  &kp I           &kp D        &hrm_right_index LEFT_SHIFT H  &hrm_right_middy LEFT_CONTROL T  &hrm_right_ringy LEFT_ALT N  &hrm_right_pinky LEFT_WIN S  &none
&none  &kp SINGLE_QUOTE             &kp Q                       &kp J                           &kp K                         &kp X           &kp B        &kp M                          &kp W                            &kp V                        &kp Z                        &none
                                                                                             &lt 6 ESCAPE  &lt 1 BACKSPACE    &lt 3 DELETE    &lt 4 ENTER  &lt 2 SPACE        &lt 5 TAB
            >;
        };

        NUMBERS {
            display-name = "Num";
            bindings = <
&trans  &trans    &trans        &trans     &trans     &trans    &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9  &kp KP_DIVIDE  &trans
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans    &kp EQUAL        &kp N4  &kp N5  &kp N6  &kp PLUS       &trans
&trans  &trans    &trans        &trans     &trans     &trans    &trans           &kp N1  &kp N2  &kp N3  &kp MINUS      &trans
                                &none      &trans     &none     &trans           &kp N0  &trans
            >;
        };

        SYMBOLS {
            display-name = "Symbols";
            bindings = <
&trans  &kp SEMI     &kp AT          &brackets     &slashes       &kp TILDE     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp GRAVE    &kp MINUS       &parenthesis  &marks         &kp EQUAL     &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LWIN  &trans
&trans  &kp PERCENT  &kp UNDERSCORE  &braces       &kp AMPERSAND  &kp POUND     &trans  &trans     &trans     &trans    &trans    &trans
                                     &kp CARET     &kp PIPE       &kp DOLLAR    &none   &trans     &none
            >;
        };

        NAV {
            display-name = "Nav";
            bindings = <
&trans  &trans    &trans        &trans     &trans     &trans    &trans  &sk LSHFT       &caps_word    &key_repeat    &browsertab  &trans
&trans  &kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans    &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW       &kp RIGHT_ARROW    &trans
&trans  &trans    &trans        &trans     &trans     &trans    &trans  &trans          &kp PAGE_UP   &kp PAGE_DOWN  &trans       &trans
                                &none      &none      &trans    &trans  &trans          &trans
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &mmv MOVE_X(-100)  &mmv MOVE_Y(-100)  &mmv MOVE_Y(100)  &mmv MOVE_X(100)  &trans       &trans  &trans     &trans     &trans        &trans        &trans
&trans  &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_UP      &mmv MOVE_LEFT   &trans       &trans  &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &msc SCRL_LEFT     &msc SCRL_DOWN     &msc SCRL_UP      &msc SCRL_LEFT   &trans       &trans  &trans     &trans     &trans        &trans        &trans
                                              &mkp MCLK         &mkp RCLK         &mkp LCLK    &trans  &none      &none
            >;
        };

        EXTRA {
            display-name = "Extra";
            bindings = <
&trans  &uc UC_LATIN_LETTER_A_WITH_ACUTE  &uc UC_LATIN_LETTER_O_WITH_ACUTE  &uc UC_LATIN_LETTER_E_WITH_ACUTE  &uc UC_LATIN_LETTER_U_WITH_ACUTE  &uc UC_LATIN_LETTER_I_WITH_ACUTE     &trans  &trans     &trans     &trans        &trans        &trans
&trans  &uc UC_SV_AO                      &uc UC_SV_OE                      &uc UC_SV_AE                      &trans                            &trans                               &trans  &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &uc UC_LATIN_LETTER_A_WITH_GRAVE  &uc UC_LATIN_LETTER_O_WITH_GRAVE  &uc UC_LATIN_LETTER_E_WITH_GRAVE  &uc UC_LATIN_LETTER_U_WITH_GRAVE  &uc UC_LATIN_LETTER_I_WITH_GRAVE     &trans  &trans     &trans     &trans        &trans        &trans
                                                                            &trans                            &trans                            &trans                               &none   &none      &trans
            >;
        };

        SYSTEM {
            display-name = "System";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans            &trans          &trans            &trans                  &trans            &trans       &trans
&trans  &bootloader   &trans        &out OUT_BLE  &out OUT_USB  &studio_unlock    &studio_unlock  &uc UC_SET_LINUX  &uc UC_SET_WIN_COMPOSE  &uc UC_SET_MACOS  &bootloader  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR    &bt BT_CLR_ALL    &trans          &trans            &trans                  &trans            &trans       &trans
                                    &none         &none         &none             &none           &none             &trans
            >;
        };
    };
};
