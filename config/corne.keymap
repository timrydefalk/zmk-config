#include <behaviors/unicode.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUMBERS 1
#define SYMBOLS 2
#define NAV 3
#define MOUSE 4
#define EXTRA 5
#define SYSTEM 6

&uc { default-mode = <UC_MODE_LINUX>; };

&lt { quick-tap-ms = <150>; };

/ {
    behaviors {
        caps_lt: caps_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "CAPS_LT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&entercaps>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>; /* tune to taste */
            hold-trigger-key-positions = <36 37 38 39 41 40 30 18 6 7 19 31 20 8 32 33 21 9 10 34 22>;
            hold-trigger-on-release;
            label = "HML";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <36 37 38 39 41 40 5 17 29 28 16 4 3 27 15 2 14 26 25 13 1>;
            hold-trigger-on-release;
            label = "HMR";
        };

        parenthesis: parenthesis {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            label = "PARENTHESIS";
        };

        brackets: brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        braces: braces {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACES";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        entercaps: entercaps {
            compatible = "zmk,behavior-tap-dance";
            label = "ENTERCAPS";
            #binding-cells = <0>;
            bindings = <&kp ENTER>, <&caps_word>;
        };

        slashes: slashes {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            label = "SLASHES";
        };

        marks: marks {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp QUESTION>;

            label = "MARKS";
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            timeout-ms = <30>;
            bindings = <&kp ESCAPE>;
            key-positions = <20 15>;
        };

        vimfind {
            timeout-ms = <30>;
            bindings = <&kp KP_DIVIDE>;
            key-positions = <16 19>;
        };

        ao {
            timeout-ms = <30>;
            bindings = <&uc UC_SV_AO>;
            key-positions = <13 22>;
        };

        oe {
            timeout-ms = <30>;
            bindings = <&uc UC_SV_OE>;
            key-positions = <14 22>;
        };

        ae {
            timeout-ms = <30>;
            bindings = <&uc UC_SV_AE>;
            key-positions = <15 22>;
        };

        vimcmd {
            bindings = <&kp COLON>;
            key-positions = <3 8>;
            timeout-ms = <30>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
&none  &kp COLON         &kp COMMA        &kp PERIOD    &kp P              &kp Y           &kp F         &kp G              &kp C                &kp R            &kp L            &none
&none  &hml LEFT_GUI A   &hml LEFT_ALT O  &hml LCTRL E  &hml LEFT_SHIFT U  &kp I           &kp D         &hmr LEFT_SHIFT H  &hmr LEFT_CONTROL T  &hmr LEFT_ALT N  &hmr LEFT_WIN S  &none
&none  &kp SINGLE_QUOTE  &kp Q            &kp J         &kp K              &kp X           &kp B         &kp M              &kp W                &kp V            &kp Z            &none
                                          &lt 5 ESCAPE  &lt 1 BACKSPACE    &lt 3 DELETE    &caps_lt 4 0  &lt 2 SPACE        &lt 6 TAB
            >;
        };

        NUMBERS {
            display-name = "Num";
            bindings = <
&trans  &trans     &trans        &trans     &trans      &trans    &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9  &kp KP_DIVIDE  &trans
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans    &kp EQUAL        &kp N4  &kp N5  &kp N6  &kp PLUS       &trans
&trans  &trans     &trans         &trans      &trans      &trans    &kp N0           &kp N1  &kp N2  &kp N3  &kp MINUS      &trans
                                &none      &trans     &none    &trans           &trans  &trans
            >;
        };

        SYMBOLS {
            display-name = "Symbols";
            bindings = <
&trans  &kp SEMI     &kp AT          &brackets     &slashes       &kp TILDE     &trans  &trans      &trans      &trans     &trans     &trans
&trans  &kp GRAVE    &kp MINUS       &parenthesis  &marks         &kp EQUAL     &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LWIN  &trans
&trans  &kp PERCENT  &kp UNDERSCORE  &braces       &kp AMPERSAND  &kp POUND     &trans  &trans      &trans      &trans     &trans     &trans
                                     &kp CARET     &kp PIPE       &kp DOLLAR    &none  &trans     &none
            >;
        };

        NAV {
            display-name = "Nav";
            bindings = <
&trans  &trans    &trans        &trans     &trans     &trans    &trans  &sk LSHFT       &caps_word    &key_repeat    &browsertab  &trans
&trans  &kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans    &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN       &kp RIGHT    &trans
&trans  &trans    &trans        &trans     &trans     &trans    &trans  &trans          &kp PAGE_UP   &kp PAGE_DOWN  &trans       &trans
                                &none      &none      &trans    &trans  &trans          &trans
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &mmv MOVE_X(-100)  &mmv MOVE_Y(-100)  &mmv MOVE_Y(100)  &mmv MOVE_X(100)  &trans       &trans  &trans     &trans     &trans        &trans        &trans
&trans  &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_UP      &mmv MOVE_RIGHT   &trans       &trans  &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &msc SCRL_LEFT     &msc SCRL_DOWN     &msc SCRL_UP      &msc SCRL_RIGHT   &trans       &trans  &trans     &trans     &trans        &trans        &trans
                                              &mkp MCLK         &mkp RCLK         &mkp LCLK    &trans  &none      &none
            >;
        };

        EXTRA {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &none   &none     &trans  &trans  &trans
            >;
        };

        SYSTEM {
            display-name = "System";
            bindings = <
&trans  &trans         &trans         &trans         &trans         &trans             &trans           &trans             &trans                   &trans             &trans        &trans
&trans  &bootloader   &trans         &out OUT_BLE  &out OUT_USB  &studio_unlock    &studio_unlock  &uc UC_SET_LINUX  &uc UC_SET_WIN_COMPOSE  &uc UC_SET_MACOS  &bootloader  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR    &bt BT_CLR_ALL    &trans           &trans             &trans                   &trans             &trans        &trans
                                    &trans        &none         &trans            &trans          &none             &trans
            >;
        };
    };
};
